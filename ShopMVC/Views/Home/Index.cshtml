@model List<ShopMVC.Models.Category>

<div class="container">
    <h2 class="mb-4 text-center">Danh mục sản phẩm</h2>
    <div class="row g-3">
        @foreach (var c in Model)
        {
            <div class="col-md-4">
                <div class="card p-3 text-center h-100">
                    <h5>@c.Name</h5>
                    <a class="btn btn-primary mt-3" asp-controller="Product" asp-action="Category" asp-route-id="@c.Id">Xem sản phẩm</a>
                </div>
            </div>
        }
    </div>
</div>
